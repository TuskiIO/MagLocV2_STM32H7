<mxfile host="app.diagrams.net" modified="2025-09-15T00:00:00.000Z" agent="github-copilot" version="22.0.3">
  <diagram id="MgLocV2Arch" name="MagLocV2 Software System Architecture">
    <mxGraphModel dx="1700" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- PC / Host -->
        <mxCell id="pc" value="PC / Host" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- STM32 Container -->
        <mxCell id="stm32" value="STM32H743 (FreeRTOS)\nApplications / Middleware / Peripherals" style="shape=swimlane;rounded=1;whiteSpace=wrap;html=1;horizontal=0;startSize=28;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="920" height="680" as="geometry"/>
        </mxCell>

        <!-- Sections inside STM32 -->
        <mxCell id="tasks" value="Tasks" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="stm32">
          <mxGeometry x="20" y="40" width="260" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="middlewares" value="Middleware" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="stm32">
          <mxGeometry x="300" y="40" width="300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="peripherals" value="Peripherals" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="stm32">
          <mxGeometry x="620" y="40" width="280" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="apps" value="Application Modules" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="stm32">
          <mxGeometry x="20" y="360" width="880" height="300" as="geometry"/>
        </mxCell>

        <!-- Task details -->
        <mxCell id="task_default" value="Network &amp; USB Task\n- Networking initialization\n- USB device enable\n- Basic indicators / stats" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;" vertex="1" parent="tasks">
          <mxGeometry x="10" y="10" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="task_adc" value="IMU &amp; ADC Task\n- Read gyro/accel/temperature\n- On-board CPU temperature via ADC\n- Optional USB debug output" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;" vertex="1" parent="tasks">
          <mxGeometry x="10" y="100" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="task_modbus" value="Modbus &amp; Acquisition Task\n- Time sync integration\n- RS485 Modbus master\n- Discovery / addressing / configuration\n- Periodic trigger + readout\n- Data framing &amp; UDP streaming" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;" vertex="1" parent="tasks">
          <mxGeometry x="10" y="200" width="240" height="110" as="geometry"/>
        </mxCell>

        <!-- Middleware -->
        <mxCell id="mw_lwip" value="LwIP / UDP\n- Control channel (inbound)\n- Data streaming (outbound)" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;" vertex="1" parent="middlewares">
          <mxGeometry x="10" y="10" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="mw_ptp" value="gPTP / PTPd\n- Time synchronization\n- Unified timestamp base" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;" vertex="1" parent="middlewares">
          <mxGeometry x="10" y="110" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mw_usb" value="USB Device (CDC)\n- Diagnostics / logging" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;" vertex="1" parent="middlewares">
          <mxGeometry x="10" y="200" width="280" height="60" as="geometry"/>
        </mxCell>

        <!-- Peripherals -->
        <mxCell id="per_uart" value="LPUART1 + DMA + Idle IRQ\n- RS485 half-duplex\n- DMA idle reception\n- Buffering &amp; D-Cache coherence" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;" vertex="1" parent="peripherals">
          <mxGeometry x="10" y="10" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="per_timers" value="Timers (TIM2/TIM4)\n- Timestamps / microsecond delays" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;" vertex="1" parent="peripherals">
          <mxGeometry x="10" y="130" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="per_crc" value="CRC Unit\n- Modbus CRC-16" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;" vertex="1" parent="peripherals">
          <mxGeometry x="10" y="190" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="per_spi" value="SPI / ADC3\n- ICM42688P IMU &amp; board resources" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;" vertex="1" parent="peripherals">
          <mxGeometry x="10" y="250" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- Applications -->
        <mxCell id="app_modbus" value="Modbus RTU Master\n- Device discovery\n- Deterministic addressing\n- Trigger measurement\n- Register access (read/write)" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#d81b60;" vertex="1" parent="apps">
          <mxGeometry x="10" y="10" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="app_mag" value="Mag Sensor Manager\n- Configuration &amp; calibration\n- Data parsing &amp; packaging\n- Hot-plug handling" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#d81b60;" vertex="1" parent="apps">
          <mxGeometry x="300" y="10" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="app_udp" value="UDP Protocol Adapter\n- Control plane (in)\n- Data plane (out)\n- Payload framing" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#d81b60;" vertex="1" parent="apps">
          <mxGeometry x="10" y="140" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="app_imu" value="IMU Service\n- IMU sampling\n- Optional debug output" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#d81b60;" vertex="1" parent="apps">
          <mxGeometry x="300" y="140" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="app_stats" value="Monitoring &amp; Telemetry\n- Timestamps / counters\n- LED indicators" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#d81b60;" vertex="1" parent="apps">
          <mxGeometry x="590" y="10" width="280" height="120" as="geometry"/>
        </mxCell>

        <!-- RS485 Sensor chain -->
        <mxCell id="rs485_chain" value="Magnetometer Sensor Chain (RS485 multi-drop)" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1270" y="160" width="300" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="sensor1" value="Sensor #1\nUID / Address / Data" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;" vertex="1" parent="rs485_chain">
          <mxGeometry x="20" y="20" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sensor2" value="Sensor #2" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;" vertex="1" parent="rs485_chain">
          <mxGeometry x="160" y="20" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sensorn" value="... Sensor #N" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#8e24aa;" vertex="1" parent="rs485_chain">
          <mxGeometry x="90" y="100" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Edges: PC <-> STM32 (UDP) -->
        <mxCell id="edge_pc_to_udp" value="UDP control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#6c8ebf;" edge="1" parent="1" source="pc" target="stm32">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_udp_to_pc" value="UDP data stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=classic;strokeColor=#6c8ebf;" edge="1" parent="1" source="stm32" target="pc">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="180" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Edges: ModbusTask <-> LPUART1 (RS485) -->
        <mxCell id="edge_task_uart" value="Modbus RTU bus" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#1e88e5;" edge="1" parent="stm32" source="task_modbus" target="per_uart">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge: UART -> Sensor chain -->
        <mxCell id="edge_uart_sensors" value="RS485 half-duplex\nDiscovery / addressing / trigger / read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#8e24aa;" edge="1" parent="1" source="stm32" target="rs485_chain">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1240" y="310" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Edges inside STM32: ModbusTask uses Apps/MWs -->
        <mxCell id="edge_task_lwip" value="UDP I/O" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#fb8c00;" edge="1" parent="stm32" source="task_modbus" target="mw_lwip">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_task_ptp" value="Time sync" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#fb8c00;" edge="1" parent="stm32" source="task_modbus" target="mw_ptp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_task_apps_modbus" value="Protocol logic" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#d81b60;" edge="1" parent="stm32" source="task_modbus" target="app_modbus">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_task_apps_mag" value="Config / packaging" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#d81b60;" edge="1" parent="stm32" source="task_modbus" target="app_mag">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_task_apps_udp" value="Control &amp; data path" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#d81b60;" edge="1" parent="stm32" source="task_modbus" target="app_udp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge: AdcTask -> IMU app and USB -->
        <mxCell id="edge_adc_imu" value="IMU data" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#d81b60;" edge="1" parent="stm32" source="task_adc" target="app_imu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge_adc_usb" value="Debug (CDC)" style="edgeStyle=elbowEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;strokeColor=#fb8c00;" edge="1" parent="stm32" source="task_adc" target="mw_usb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Build & Deployment note -->
        <mxCell id="build_note" value="Build &amp; Deployment\n- CMake + Ninja\n- STM32CubeProgrammer (SWD)" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ffff88;strokeColor=#b3a100;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="240" height="80" as="geometry"/>
        </mxCell>

        <!-- Thesis Contributions -->
        <mxCell id="contrib" value="Thesis Contributions\n- RS485 Modbus master with DMA-idle reception and CRC\n- Sensor discovery and deterministic ID assignment\n- Periodic triggering, acquisition, validation, packaging\n- Lightweight UDP protocol (control + data), PC interoperability\n- gPTP-based time alignment and timestamping\n- IMU integration and system health telemetry" style="shape=note;whiteSpace=wrap;html=1;fillColor=#ccffcc;strokeColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="960" y="20" width="340" height="140" as="geometry"/>
        </mxCell>

